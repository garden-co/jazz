{
  "$schema": "https://turbo.build/schema.json",
  "remoteCache": {
    "signature": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "pkg/**"],
      "env": ["JAZZ_NAPI_RELEASE"],
      "passThroughEnv": ["JAZZ_TEST_SEALED_TOOLS_DIST"]
    },
    "inspector#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-embedded/**", "dist-extension/**"]
    },
    "docs#build": {
      "dependsOn": [
        "todo-client-localfirst-react#build",
        "todo-client-localfirst-ts#build",
        "todo-server-ts#build",
        "todo-client-localfirst-react-docs#build",
        "todo-client-localfirst-ts-docs#build",
        "todo-client-localfirst-solid-docs#build",
        "todo-client-localfirst-svelte-docs#build",
        "todo-client-localfirst-vue-docs#build",
        "todo-client-localfirst-expo-docs#build",
        "todo-server-ts-docs#build"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "jazz-napi#build": {
      "cache": false,
      "inputs": [
        "package.json",
        "Cargo.toml",
        "build.rs",
        "scripts/build.js",
        "src/**/*.rs",
        "$TURBO_ROOT$/dev/artifacts/**",
        "$TURBO_ROOT$/crates/jazz-napi/package.json",
        "$TURBO_ROOT$/crates/jazz-napi/index.cjs",
        "$TURBO_ROOT$/crates/jazz-napi/index.mjs",
        "$TURBO_ROOT$/crates/jazz-napi/index.d.ts",
        "$TURBO_ROOT$/crates/jazz-napi/native-binding.cjs",
        "$TURBO_ROOT$/crates/jazz-napi/Cargo.toml",
        "$TURBO_ROOT$/crates/jazz-napi/build.rs",
        "$TURBO_ROOT$/crates/jazz-napi/scripts/**",
        "$TURBO_ROOT$/crates/jazz-napi/src/**/*.rs",
        "$TURBO_ROOT$/crates/jazz-otel/**",
        "$TURBO_ROOT$/crates/jazz/**",
        "$TURBO_ROOT$/crates/groove/**",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/.cargo/**",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/turbo.json"
      ],
      "passThroughEnv": [
        "JAZZ_RN_TEST_BRIDGE",
        "JAZZ_TEST_ARTIFACT_LOCK_PATH",
        "JAZZ_ARTIFACT_BUILD_LEASE",
        "JAZZ_ARTIFACT_BUILD_LOCK_PATH",
        "JAZZ_TEST_SEALED_TOOLS_DIST"
      ],
      "outputs": [
        "native-binding.pointer.cjs",
        "native-artifact-fingerprint.cjs",
        ".native-artifacts/**"
      ]
    },
    "jazz-wasm#build": {
      "inputs": [
        "package.json",
        "Cargo.toml",
        "src/**/*.rs",
        "$TURBO_ROOT$/dev/artifacts/**",
        "$TURBO_ROOT$/crates/jazz/**",
        "$TURBO_ROOT$/crates/groove/**",
        "$TURBO_ROOT$/crates/wasm-tracing/**",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/.cargo/**",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/turbo.json"
      ],
      "passThroughEnv": [
        "JAZZ_TEST_ARTIFACT_LOCK_PATH",
        "JAZZ_ARTIFACT_BUILD_LEASE",
        "JAZZ_ARTIFACT_BUILD_LOCK_PATH",
        "JAZZ_TEST_SEALED_TOOLS_DIST"
      ],
      "cache": false,
      "outputs": []
    },
    "jazz-wasm#build:fast": {
      "inputs": [
        "package.json",
        "Cargo.toml",
        "src/**/*.rs",
        "$TURBO_ROOT$/dev/artifacts/**",
        "$TURBO_ROOT$/crates/jazz/**",
        "$TURBO_ROOT$/crates/groove/**",
        "$TURBO_ROOT$/crates/wasm-tracing/**",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/.cargo/**",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/turbo.json"
      ],
      "passThroughEnv": [
        "JAZZ_TEST_ARTIFACT_LOCK_PATH",
        "JAZZ_ARTIFACT_BUILD_LEASE",
        "JAZZ_ARTIFACT_BUILD_LOCK_PATH",
        "JAZZ_TEST_SEALED_TOOLS_DIST"
      ],
      "cache": false,
      "outputs": []
    },
    "jazz-tools#build": {
      "cache": false,
      "inputs": [
        "package.json",
        "src/**",
        "$TURBO_ROOT$/crates/jazz-napi/*.node",
        "$TURBO_ROOT$/crates/jazz-napi/index.js",
        "$TURBO_ROOT$/crates/jazz-napi/index.d.ts",
        "$TURBO_ROOT$/crates/jazz-napi/.jazz-artifact-manifest.json",
        "$TURBO_ROOT$/crates/jazz-wasm/pkg/**",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/turbo.json"
      ],
      "outputs": ["dist/**"],
      "passThroughEnv": [
        "JAZZ_TEST_SEALED_TOOLS_DIST",
        "JAZZ_CORRECTNESS_ARTIFACT_RUN",
        "JAZZ_CORRECTNESS_WASM_PACKAGE",
        "JAZZ_CORRECTNESS_NAPI_BINDING",
        "JAZZ_CORRECTNESS_NAPI_FINGERPRINT"
      ]
    },
    "build:crates": {
      "dependsOn": ["^build:crates"],
      "inputs": [
        "package.json",
        "$TURBO_ROOT$/crates/jazz-cli/Cargo.toml",
        "$TURBO_ROOT$/crates/jazz-cli/src/**/*.rs",
        "$TURBO_ROOT$/crates/jazz/Cargo.toml",
        "$TURBO_ROOT$/crates/jazz/src/**/*.rs",
        "$TURBO_ROOT$/crates/groove/Cargo.toml",
        "$TURBO_ROOT$/crates/groove/src/**/*.rs",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/.cargo/**"
      ],
      "outputs": ["$TURBO_ROOT$/target/debug/jazz-tools"]
    },
    "build:rn": {
      "dependsOn": ["^build:rn"],
      "inputs": [
        "rust/**",
        "$TURBO_ROOT$/crates/**/*.rs",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock"
      ],
      "outputs": ["android/**", "ios/**", "lib/**", "src/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "JAZZ_TEST_SEALED_TOOLS_DIST",
        "JAZZ_CORRECTNESS_ARTIFACT_RUN",
        "JAZZ_CORRECTNESS_WASM_PACKAGE",
        "JAZZ_CORRECTNESS_NAPI_BINDING",
        "JAZZ_CORRECTNESS_NAPI_FINGERPRINT",
        "JAZZ_CORRECTNESS_CONSUMER_CAPABILITY",
        "JAZZ_CORRECTNESS_CONSUMER_TOKEN"
      ]
    },
    "rn-device-acceptance#test": {
      "dependsOn": [],
      "cache": false
    },
    "rn-device-acceptance#build": {
      "dependsOn": [],
      "cache": false
    }
  }
}
