      }
    },
    "notes": { "columns": { "text": "string" } }
  },
  "history": {
    "v1": {
      "tables": {
        "projects": { "columns": { "name": "string", "ownerId": "uuid" } },
        "tasks": {
          "columns": {
            "projectId": { "type": "uuid", "references": "projects" },
            "title": "bytes",
            "__e2ee_eq_title": "bytes",
            "label": "string?"
          },
          "encryption": {
            "space": "projectId",
            "scope": "projects",
            "columns": { "title": "string" },
            "equality": ["title"]
          }
        },
        "notes": { "columns": { "text": "string" } }
      }
    }
  },
  "migrations": [
