{
  "$schema": "https://jazz.tools/schemas/jazz.app.v1.json",
  "tables": {
    "projects": { "columns": { "name": "string", "ownerId": "uuid" } },
    "tasks": {
      "columns": {
        "projectId": "uuid",
        "title": "bytes",
        "__e2ee_eq_title": "bytes",
        "label": "string?",
