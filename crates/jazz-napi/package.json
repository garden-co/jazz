{
  "name": "jazz-napi",
  "version": "2.0.0-alpha.54",
  "description": "Native Node.js bindings for Jazz runtime",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/garden-co/jazz2"
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "index.js",
    "index.d.ts",
    "close-pollable.cjs",
    "native-binding.cjs",
    "native-loader.cjs",
    "native-artifact-fingerprint.cjs",
    "jazz-napi.*.node",
    "jazz-napi.*.manifest.json"
  ],
  "main": "index.cjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs",
      "default": "./index.cjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:debug": "node scripts/build.js --debug",
    "build:perf": "node scripts/build.js --profile perf",
    "build:perf:sccache": "RUSTC_WRAPPER=sccache node scripts/build.js --profile perf",
    "prepack": "node ../../dev/artifacts/stage-napi-loader.mjs",
    "test": "node --test tests/*.test.cjs && pnpm typecheck:consumer",
    "typecheck:consumer": "tsc --project tests/types/tsconfig.json"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3",
    "@types/node": "catalog:default"
  },
  "napi": {
    "binaryName": "jazz-napi",
    "packageName": "@garden-co/jazz-napi",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin"
    ]
  }
}
