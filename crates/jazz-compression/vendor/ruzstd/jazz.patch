+            target[first_count..amount].copy_from_slice(&second[second_start..second_start + amount - first_count]);
+        }
+        self.streaming_read_position += amount;
+        let retain = if finished { 0 } else { self.window_size };
+        let discard = self.streaming_read_position.min(self.buffer.len().saturating_sub(retain));
+        if discard != 0 { self.buffer.drop_first_n(discard); }
+        self.streaming_read_position -= discard;
