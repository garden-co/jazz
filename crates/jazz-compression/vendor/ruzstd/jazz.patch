+    /// Copy each byte once, retaining already-delivered dictionary history.
+    /// Must not be mixed with the original draining API on the same frame.
+    pub fn read_streaming(&mut self, target: &mut [u8], finished: bool) -> usize {
+        let amount = target
+            .len()
+            .min(self.buffer.len() - self.streaming_read_position);
+        let (first, second) = self.buffer.as_slices();
+        let start = self.streaming_read_position;
+        let first_count = amount.min(first.len().saturating_sub(start));
+        if first_count != 0 {
+            target[..first_count].copy_from_slice(&first[start..start + first_count]);
+        }
+        if amount > first_count {
+            let second_start = start.saturating_sub(first.len());
+            target[first_count..amount]
+                .copy_from_slice(&second[second_start..second_start + amount - first_count]);
+        }
+        self.streaming_read_position += amount;
+        let retain = if finished { 0 } else { self.window_size };
+        let discard = self
+            .streaming_read_position
+            .min(self.buffer.len().saturating_sub(retain));
+        if discard != 0 {
+            self.buffer.drop_first_n(discard);
+        }
+        self.streaming_read_position -= discard;
+        amount
+    }
