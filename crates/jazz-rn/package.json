{
  "name": "jazz-rn",
  "version": "2.0.0-alpha.53",
  "description": "React Native native-relay bridge for Jazz (development builds only)",
  "keywords": [
    "JazzNativeRelay.xcframework",
    "android",
    "ios",
    "native",
    "react-native"
  ],
  "homepage": "https://github.com/garden-co/jazz/tree/main/crates/jazz-rn#readme",
  "bugs": {
    "url": "https://github.com/garden-co/jazz/issues"
  },
  "license": "MIT",
  "author": "Antonio Musolino <antoniomusolino007@gmail.com> (https://github.com/antoniomuso)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garden-co/jazz.git"
  },
  "files": [
    "src",
    "scripts",
    "lib",
    "android",
    "ios",
    "native/**",
    "android/src/main/jniLibs/**/*",
    "JazzNativeRelay.xcframework/**",
    "app.plugin.js",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/src/index.d.ts",
      "source": "./src/index.tsx",
      "default": "./lib/module/index.js"
    },
    "./relay": {
      "types": "./lib/typescript/src/relay.d.ts",
      "source": "./src/relay.ts",
      "default": "./lib/module/relay.js"
    },
    "./app.plugin": "./app.plugin.js",
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "alpha"
  },
  "scripts": {
    "build": "bob build",
    "test:codegen": "bash scripts/test-codegen.sh",
    "build:relay:android": "bash scripts/build-relay-artifacts.sh android",
    "build:relay:ios": "bash scripts/build-relay-artifacts.sh ios",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "prepare": "bob build"
  },
  "dependencies": {},
  "devDependencies": {
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@evilmartians/lefthook": "^1.12.3",
    "@react-native-community/cli": "20.0.1",
    "@react-native/babel-preset": "^0.81.5",
    "@react-native/eslint-config": "^0.81.5",
    "@release-it/conventional-changelog": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.0",
    "commitlint": "^19.8.1",
    "del-cli": "^6.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "react": "19.2.4",
    "react-native": "0.81.5",
    "react-native-builder-bob": "^0.40.14",
    "release-it": "^19.0.4",
    "turbo": "^2.5.6",
    "typescript": "catalog:default"
  },
  "peerDependencies": {
    "expo": ">=54",
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "prettier": {
    "overrides": [
      {
        "files": "react-native.config.js",
        "options": {
          "singleQuote": false
        }
      }
    ],
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "jest": {
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "preset": "react-native"
  },
  "packageManager": "pnpm@10.16.1",
  "codegenConfig": {
    "name": "JazzRelaySpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.jazzrn"
    }
  },
  "create-react-native-library": {
    "languages": "kotlin-objc",
    "type": "turbo-module",
    "version": "0.54.8"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  }
}
