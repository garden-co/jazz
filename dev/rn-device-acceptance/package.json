{
  "name": "rn-device-acceptance",
  "version": "0.0.0",
  "private": true,
  "main": "./index.js",
  "scripts": {
    "start": "expo start --dev-client --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "test:protocol": "node --experimental-strip-types --test src/protocol.test.ts",
    "verify": "pnpm test:protocol && pnpm typecheck",
    "device:android": "node scripts/run-android.mjs",
    "device:ios": "node scripts/run-ios.mjs"
  },
  "dependencies": {
    "expo": "^54.0.0",
    "expo-dev-client": "~6.0.0",
    "jazz-rn": "workspace:*",
    "jazz-tools": "workspace:*",
    "metro-runtime": "0.83.3",
    "react": "19.2.4",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "babel-preset-expo": "~54.0.10",
    "typescript": "catalog:default"
  }
}
