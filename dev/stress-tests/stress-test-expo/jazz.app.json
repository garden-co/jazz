{
  "$schema": "https://jazz.tools/schemas/jazz.app.schema.json",
  "format": 1,
  "tables": {
    "projects": {
      "columns": { "name": "string" },
      "relations": { "todosViaProject": { "reverse": "todos", "relation": "project" } }
    },
    "todos": {
      "columns": {
        "title": "string",
        "done": "boolean",
        "description": "string?",
        "owner_id": "string",
        "parentId": "uuid?",
        "projectId": "uuid?"
      },
      "relations": {
        "parent": { "rel": "todos", "column": "parentId" },
        "project": { "rel": "projects", "column": "projectId" },
        "todosViaParent": { "reverse": "todos", "relation": "parent" }
      }
    }
  }
}
