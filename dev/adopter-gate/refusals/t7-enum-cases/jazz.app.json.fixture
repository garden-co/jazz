{
  "$schema": "https://jazz.tools/schemas/jazz.app.schema.json",
  "format": 1,
  "tables": {
    "tickets": {
      "columns": {
        "title": "string",
        "owner_id": "uuid",
        "kind": {
          "enum": { "bug": { "severity": "int" }, "feature": { "area": "string" } },
          "optional": true
        }
      }
    }
  }
}
