<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Cleartext: the test's server is on the host's loopback (adb reverse). -->
    <application android:allowBackup="false" android:usesCleartextTraffic="true">
        <activity android:name="smoke.SmokeActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name="smoke.HolderService" android:exported="false" android:process=":holder" />
    </application>
</manifest>
