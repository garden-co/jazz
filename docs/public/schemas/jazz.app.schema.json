{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jazz.tools/schemas/jazz.app.schema.json",
  "title": "jazz.app.json",
  "description": "An app's tables, relations, computed fields, transforms, schema history and migrations. The app and its clients ship this file. See https://jazz.tools/docs/reference/app-files",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "tables"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "format": {
      "const": 1
    },
    "tables": {
      "$ref": "#/$defs/tables",
      "description": "The current schema."
    },
    "history": {
      "type": "object",
      "description": "Earlier versions the app still ships, oldest first, by name.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tables"],
        "properties": {
          "tables": {
            "$ref": "#/$defs/tables"
          },
          "$comment": {
            "type": "string"
          }
        }
      }
    },
    "migrations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/migration"
      }
    },
    "transforms": {
      "type": "object",
      "description": "Transforms columns name with \"transform\": a type the engine stores and the type code reads and writes. Every language implements each one.",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stored", "view"],
        "properties": {
          "stored": {
            "$ref": "#/$defs/plainType"
          },
          "view": {
            "$ref": "#/$defs/plainType"
          },
          "$comment": {
            "type": "string"
          }
        },
        "description": "e.g. { \"stored\": \"timestamp\", \"view\": \"string\" }"
      }
    }
  },
  "$defs": {
    "tables": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/table"
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns"],
      "properties": {
        "$comment": {
          "type": "string"
        },
        "columns": {
          "type": "object",
          "description": "Columns in declared order, e.g. { \"userId\": \"uuid\", \"avatar\": \"string?\" }.",
          "additionalProperties": {
            "$ref": "#/$defs/column"
          }
        },
        "relations": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["rel", "column"],
                "properties": {
                  "rel": {
                    "type": "string",
                    "description": "The table this table's column points to."
                  },
                  "column": {
                    "type": "string"
                  }
                },
                "description": "e.g. { \"rel\": \"chats\", \"column\": \"chatId\" }"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["reverse", "relation"],
                "properties": {
                  "reverse": {
                    "type": "string"
                  },
                  "relation": {
                    "type": "string",
                    "description": "The forward relation on that table that points here."
                  }
                },
                "description": "e.g. { \"reverse\": \"messages\", \"relation\": \"chat\" }"
              }
            ]
          }
        },
        "indexes": {
          "type": "array",
          "description": "A column name is a single-column index (listing any makes them the only ones); an array of names is a composite index; an object with `name` and exactly one of `text`, `vector` or `geo` is a specialised index.",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              {
                "$ref": "#/$defs/textIndex"
              },
              {
                "$ref": "#/$defs/vectorIndex"
              },
              {
                "$ref": "#/$defs/geoIndex"
              }
            ]
          }
        },
        "branchBy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "history": {
          "const": "latest",
          "description": "Keep only each row's newest version."
        },
        "computed": {
          "type": "object",
          "description": "Fields computed in code from stored columns, not stored. Every language implements each one.",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "from"],
            "properties": {
              "type": {
                "$ref": "#/$defs/columnType"
              },
              "from": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Stored columns of this table (or id), in the order the implementation takes them."
              },
              "$comment": {
                "type": "string"
              }
            },
            "description": "e.g. { \"type\": { \"enum\": [\"low\", \"high\"] }, \"from\": [\"score\"] }"
          }
        }
      }
    },
    "column": {
      "description": "A type string (\"string\", \"uuid?\", …) or an object with one of type / enum / json / array / vector and options.",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(string|int|bigint|float|boolean|timestamp|uuid|bytes)\\??$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": ["string", "int", "bigint", "float", "boolean", "timestamp", "uuid", "bytes"]
            },
            "enum": {},
            "json": {},
            "array": {
              "$ref": "#/$defs/columnType"
            },
            "vector": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096,
              "description": "A vector of this many float32 values (SPEC 20.1), e.g. { \"vector\": 384 }. Its default is an array of that many numbers."
            },
            "optional": {
              "type": "boolean"
            },
            "default": {},
            "merge": {
              "enum": ["counter", "g-set", "text", "markdown", "html"]
            },
            "references": {
              "type": "string"
            },
            "transform": {
              "type": "string",
              "description": "A transform of the top-level transforms that this column's stored value goes through."
            },
            "$comment": {
              "type": "string"
            }
          }
        }
      ]
    },
    "columnType": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(string|int|bigint|float|boolean|timestamp|uuid|bytes)\\??$"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": ["string", "int", "bigint", "float", "boolean", "timestamp", "uuid", "bytes"]
            },
            "enum": {},
            "json": {},
            "array": {
              "$ref": "#/$defs/columnType"
            }
          }
        }
      ]
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from"],
      "properties": {
        "name": {
          "type": "string",
          "description": "What `migrations create --name` recorded."
        },
        "$comment": {
          "type": "string"
        },
        "from": {
          "type": "string",
          "description": "A version of `history`."
        },
        "to": {
          "type": "string",
          "description": "A version of `history`; absent means the current tables."
        },
        "createTables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dropTables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "renameTables": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "new name → old name"
        },
        "migrate": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["add"],
                  "properties": {
                    "add": {
                      "$ref": "#/$defs/columnType"
                    },
                    "default": {}
                  },
                  "description": "e.g. { \"add\": \"string\", \"default\": \"\" }"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["drop"],
                  "properties": {
                    "drop": {
                      "$ref": "#/$defs/columnType"
                    },
                    "backwardsDefault": {}
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["renameFrom"],
                  "properties": {
                    "renameFrom": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "plainType": {
      "description": "A type without `?` or options.",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(string|int|bigint|float|boolean|timestamp|uuid|bytes)$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "type": {
              "enum": ["string", "int", "bigint", "float", "boolean", "timestamp", "uuid", "bytes"]
            },
            "enum": {},
            "json": {},
            "array": {
              "$ref": "#/$defs/columnType"
            }
          }
        }
      ]
    },
    "textIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "text", "analyzer"],
      "description": "Word search, e.g. { \"name\": \"search\", \"text\": { \"title\": 4, \"body\": 1 }, \"analyzer\": \"jazz-text/1:en\", \"prefix\": true }",
      "properties": {
        "$comment": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 32,
          "description": "Unique among the table's text, vector and geo indexes."
        },
        "text": {
          "type": "object",
          "minProperties": 1,
          "description": "String column → its weight, or { weight, length } with the field's reference length in terms (default 32; about 256 suits long text).",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 15
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["weight"],
                "properties": {
                  "weight": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 15
                  },
                  "length": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4096
                  }
                }
              }
            ]
          }
        },
        "analyzer": {
          "enum": ["jazz-text/1:en", "jazz-text/1:simple"]
        },
        "prefix": {
          "type": "boolean",
          "description": "The last query word also matches as a prefix."
        },
        "serverOnly": {
          "type": "boolean",
          "description": "Not supported yet: an index declaring it is refused."
        }
      }
    },
    "vectorIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "vector", "metric"],
      "description": "Nearest-neighbour search, e.g. { \"name\": \"similar\", \"vector\": \"embedding\", \"metric\": \"cosine\" }",
      "properties": {
        "$comment": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 32,
          "description": "Unique among the table's text, vector and geo indexes."
        },
        "vector": {
          "type": "string",
          "description": "A vector column."
        },
        "metric": {
          "enum": ["cosine", "l2", "dot"]
        },
        "ann": {
          "const": "exact",
          "description": "Exact search, the only kind supported yet."
        },
        "serverOnly": {
          "type": "boolean",
          "description": "Not supported yet: an index declaring it is refused."
        }
      }
    },
    "geoIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "geo"],
      "description": "Points on the Earth, e.g. { \"name\": \"place\", \"geo\": { \"lat\": \"lat\", \"lng\": \"lng\" } }",
      "properties": {
        "$comment": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 32,
          "description": "Unique among the table's text, vector and geo indexes."
        },
        "geo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lat", "lng"],
          "properties": {
            "lat": {
              "type": "string",
              "description": "An f64 column, degrees."
            },
            "lng": {
              "type": "string",
              "description": "An f64 column, degrees."
            }
          }
        },
        "serverOnly": {
          "type": "boolean",
          "description": "Not supported yet: an index declaring it is refused."
        }
      }
    }
  }
}
