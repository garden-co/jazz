{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "prebuild": "fumadocs-mdx",
    "predev": "fumadocs-mdx",
    "start": "next start",
    "test": "vitest run",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "test:perf-timeline": "node --experimental-strip-types --test lib/perf-timeline/*.test.ts lib/showcase/*.test.ts ../dev/benchmarks/metadata/metadata.test.ts",
    "test:perf-timeline:e2e": "node tests/perf-timeline.browser.mjs",
    "capture:example-videos": "node scripts/example-videos/todo-two-devices.mjs",
    "upload:example-videos": "node scripts/example-videos/upload.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "feed": "^5.2.1",
    "fumadocs-core": "16.6.2",
    "fumadocs-mdx": "14.2.7",
    "fumadocs-ui": "16.6.2",
    "lucide-react": "^0.563.0",
    "next": "catalog:default",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "simple-icons": "^16.17.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/mdx": "^2.0.13",
    "@types/node": "catalog:default",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/blob": "^2.8.0",
    "playwright": "1.58.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "catalog:default",
    "vitest": "catalog:default"
  }
}
