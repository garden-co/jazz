{
  "name": "stage-plan-sveltekit-hybrid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "jazz-tools validate && vite build",
    "start": "node server.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@garden-co/design": "github:garden-co/design#fe96522c2484b894380fab7f0217b76ee4bda3a2",
    "better-auth": "1.7.1",
    "jazz-napi": "workspace:*",
    "jazz-tools": "workspace:*",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "catalog:default",
    "@types/node": "catalog:default",
    "svelte-check": "catalog:default",
    "typescript": "catalog:default",
    "vite": "catalog:default"
  }
}
