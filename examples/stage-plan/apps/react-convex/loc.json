{
  "_note": "convex/_generated is generated by the Convex CLI; seed, harness.mjs and scripts/ are bench plumbing. Permission checks live in convex/lib/access.ts and are called from every function.",
  "schema": [
    "convex/schema.ts"
  ],
  "permissions": [
    "convex/lib/access.ts"
  ],
  "server": [
    "convex/auth.ts",
    "convex/auth.config.ts",
    "convex/http.ts",
    "convex/crew.ts",
    "convex/shows.ts",
    "convex/invites.ts",
    "convex/tasks.ts",
    "convex/comments.ts",
    "convex/activity.ts",
    "convex/checklist.ts",
    "convex/lib/stage.ts",
    "convex/lib/demo.ts",
    "scripts/setup-auth.mjs"
  ],
  "data": [
    "src/account.ts",
    "src/App.tsx",
    "src/main.tsx",
    "src/model/**/*.ts"
  ],
  "ui": [
    "src/components/**/*.tsx",
    "src/components/**/*.ts",
    "src/router.ts",
    "src/styles.css"
  ],
  "exclude": [
    "convex/_generated/**",
    "convex/seed.ts",
    "scripts/seed.mjs",
    "harness.mjs"
  ]
}
