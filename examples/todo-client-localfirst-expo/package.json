{
  "name": "todo-client-localfirst-expo",
  "version": "0.1.0",
  "private": true,
  "main": "./index.js",
  "scripts": {
    "start": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "check": "tsc --noEmit",
    "build": "jazz-tools validate && pnpm run check",
    "e2e:server": "node --experimental-strip-types scripts/e2e-server.mjs",
    "e2e:sync-client": "node --experimental-strip-types scripts/e2e-sync-client.mjs",
    "test": "pnpm run check",
    "native:prebuild": "expo prebuild --clean",
    "verify:expo:android": "CI=1 expo prebuild --platform android --clean --no-install",
    "verify:expo:ios": "CI=1 expo prebuild --platform ios --clean --no-install"
  },
  "dependencies": {
    "expo": "54.0.33",
    "expo-crypto": "15.0.9",
    "expo-file-system": "19.0.21",
    "expo-secure-store": "15.0.8",
    "jazz-rn": "workspace:*",
    "jazz-tools": "workspace:*",
    "metro-runtime": "0.83.3",
    "react": "19.2.4",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@babel/plugin-transform-flow-strip-types": "^7.27.1",
    "@types/react": "^19.0.0",
    "babel-preset-expo": "~54.0.10",
    "typescript": "catalog:default"
  }
}
