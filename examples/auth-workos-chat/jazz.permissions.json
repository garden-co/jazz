{
  "$schema": "https://jazz.tools/schemas/jazz.permissions.v1.json",
  "tables": {
    "messages": {
      "read": {
        "anyOf": [
          "chat_id = 'announcements'",
          { "allOf": ["chat_id = 'chat-01'", "session.claims.role in ['admin', 'member']"] }
        ]
      },
      "insert": {
        "anyOf": [
          { "allOf": ["chat_id = 'announcements'", "session.claims.role = 'admin'"] },
          { "allOf": ["chat_id = 'chat-01'", "session.claims.role in ['admin', 'member']"] }
        ]
      },
      "update": {
        "old": {
          "anyOf": [
            { "allOf": ["chat_id = 'announcements'", "session.claims.role = 'admin'"] },
            {
              "allOf": [
                "chat_id = 'chat-01'",
                { "anyOf": ["$createdBy.account = session.user", "session.claims.role = 'admin'"] }
              ]
            }
          ]
        },
        "new": "exists messages(id = this.id, chat_id = this.chat_id)"
      },
      "delete": {
        "anyOf": [
          { "allOf": ["chat_id = 'announcements'", "session.claims.role = 'admin'"] },
          {
            "allOf": [
              "chat_id = 'chat-01'",
              { "anyOf": ["$createdBy.account = session.user", "session.claims.role = 'admin'"] }
            ]
          }
        ]
      }
    }
  }
}
