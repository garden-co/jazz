{
  "name": "auth-workos-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ../../packages/jazz-tools/dist/cli.js validate && vite build",
    "preview": "vite preview",
    "test:browser": "node ../../dev/gates/run-correctness-consumer.mjs -- pnpm exec vitest run --config vitest.config.browser.ts",
    "test": "vitest run --config vitest.config.browser.ts",
    "typecheck": "tsc --noEmit",
    "dev:server": "tsx --env-file-if-exists=.env.local server/server.ts"
  },
  "dependencies": {
    "@workos-inc/node": "11.0.0",
    "express": "^4.22.1",
    "jazz-napi": "workspace:*",
    "jazz-tools": "workspace:*",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "catalog:default",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "catalog:default",
    "@vitest/browser": "catalog:default",
    "@vitest/browser-playwright": "catalog:default",
    "jose": "^6.2.1",
    "tsx": "^4.21.0",
    "typescript": "catalog:default",
    "vite": "catalog:default",
    "vite-plugin-top-level-await": "catalog:default",
    "vite-plugin-wasm": "catalog:default",
    "vitest": "catalog:default"
  }
