{
  "$schema": "https://jazz.tools/schemas/jazz.permissions.schema.json",
  "format": 1,
  "tables": {
    "messages": {
      "read": {
        "anyOf": [
          "chat_id = 'announcements'",
          { "allOf": ["chat_id = 'chat-01'", "session.claims.role in ['admin', 'member']"] }
        ]
      },
      "insert": {
        "anyOf": [
          { "allOf": ["chat_id = 'announcements'", "session.claims.role = 'admin'"] },
          { "allOf": ["chat_id = 'chat-01'", "session.claims.role in ['admin', 'member']"] }
        ]
      },
      "update": {
        "anyOf": [
          { "allOf": ["chat_id = 'announcements'", "session.claims.role = 'admin'"] },
          {
            "allOf": [
              "chat_id = 'chat-01'",
              { "anyOf": ["$createdBy.account = session.user", "session.claims.role = 'admin'"] }
            ]
          }
        ]
      },
      "delete": {
        "anyOf": [
          { "allOf": ["chat_id = 'announcements'", "session.claims.role = 'admin'"] },
          {
            "allOf": [
              "chat_id = 'chat-01'",
              { "anyOf": ["$createdBy.account = session.user", "session.claims.role = 'admin'"] }
            ]
          }
        ]
      }
    }
  }
}
