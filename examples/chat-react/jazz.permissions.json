{
  "$schema": "https://jazz.tools/schemas/jazz.permissions.v1.json",
  "tables": {
    "canvases": {
      "read": "allowedTo.read(chat)",
      "insert": "exists chatMembers(chatId = this.chatId, userId = session.user)"
    },
    "chatMembers": {
      "read": {
        "anyOf": [
          "userId = session.user",
          "exists chatMembers(chatId = this.chatId, userId = session.user)"
        ]
      },
      "insert": {
        "anyOf": [
          { "allOf": ["userId = session.user", "exists chats(id = this.chatId, isPublic = true)"] },
          {
            "allOf": [
              "userId = session.user",
              "exists chats(id = this.chatId, $createdBy.account = session.user)"
            ]
          },
          {
            "allOf": [
              "userId = session.user",
              "joinCode != null",
              "exists chats(id = this.chatId, joinCode = this.joinCode)"
            ]
          }
        ]
      },
      "delete": "userId = session.user"
    },
    "chats": {
      "read": {
        "anyOf": [
          "isPublic = true",
          "exists chatMembers(chatId = this.id, userId = session.user)",
          "joinCode = session.claims.join_code"
        ]
      },
      "insert": "$createdBy.account = session.user",
      "update": {
        "old": "exists chatMembers(chatId = this.id, userId = session.user)",
        "new": {
          "allOf": [
            "exists chatMembers(chatId = this.id, userId = session.user)",
            "exists chats(id = this.id, isPublic = this.isPublic)"
          ]
        }
      }
    },
    "messages": {
      "read": {
        "anyOf": [
          "exists chats(id = this.chatId, isPublic = true)",
          "exists chatMembers(chatId = this.chatId, userId = session.user)"
        ]
      },
      "insert": {
        "allOf": [
          "exists chatMembers(chatId = this.chatId, userId = session.user)",
          "exists profiles(id = this.senderId, userId = session.user)"
        ]
      },
      "delete": "exists profiles(id = this.senderId, userId = session.user)"
    },
    "profiles": {
      "read": "true",
      "insert": "userId = session.user",
      "update": "userId = session.user"
    },
    "reactions": {
      "read": "allowedTo.read(message)",
      "insert": "userId = session.user",
      "delete": "userId = session.user"
    },
    "strokes": {
      "read": "allowedTo.read(canvas)",
      "insert": "allowedTo.insert(canvas)",
      "delete": "$createdBy.account = session.user"
    }
  }
}
