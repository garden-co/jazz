{
  "$schema": "https://jazz.tools/schemas/jazz.permissions.schema.json",
  "format": 1,
  "tables": {
    "chatInvites": {
      "read": "false",
      "insert": "exists chats(id = this.chatId, $createdBy = session.user)",
      "delete": "exists chats(id = this.chatId, $createdBy = session.user)"
    },
    "chatMembers": {
      "read": {
        "anyOf": [
          "user_id = session.user",
          "exists chats(id = this.chatId, $createdBy = session.user)"
        ]
      },
      "insert": {
        "allOf": [
          "user_id = session.user",
          "exists chats(id = this.chatId, $createdBy = session.user)"
        ]
      },
      "delete": {
        "anyOf": [
          "user_id = session.user",
          "exists chats(id = this.chatId, $createdBy = session.user)"
        ]
      }
    },
    "chats": {
      "read": "exists chatMembers(chatId = this.id, user_id = session.user)",
      "insert": "true"
    }
  }
}
