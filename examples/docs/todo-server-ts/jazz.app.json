{
  "$schema": "https://jazz.tools/schemas/jazz.app.v1.json",
  "tables": {
    "projects": {
      "columns": { "name": "string" },
      "relations": { "todos": { "reverse": "todos", "relation": "project" } }
    },
    "todos": {
      "columns": {
        "title": "string",
        "done": "boolean",
        "description": "string?",
        "parentId": "uuid?",
        "projectId": "uuid?",
        "owner_id": "uuid"
      },
      "relations": {
        "children": { "reverse": "todos", "relation": "parent" },
        "parent": { "rel": "todos", "column": "parentId" },
        "project": { "rel": "projects", "column": "projectId" }
      }
    }
  }
}
