{
  "$schema": "https://jazz.tools/schemas/jazz.app.v1.json",
  "tables": {
    "chatInvites": {
      "columns": { "chatId": "uuid", "code": "string", "singleUse": "boolean" },
      "relations": { "chat": { "rel": "chats", "column": "chatId" } }
    },
    "chatMembers": {
      "columns": { "chatId": "uuid", "user_id": "uuid", "inviteId": "string?" },
      "relations": { "chat": { "rel": "chats", "column": "chatId" } }
    },
    "chats": {
      "columns": {},
      "relations": {
        "invites": { "reverse": "chatInvites", "relation": "chat" },
        "members": { "reverse": "chatMembers", "relation": "chat" }
      }
    }
  }
}
