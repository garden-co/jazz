{
  "$schema": "https://jazz.tools/schemas/jazz.app.schema.json",
  "format": 1,
  "tables": {
    "comments": {
      "columns": { "body": "string", "taskId": "uuid" },
      "relations": { "task": { "rel": "tasks", "column": "taskId" } }
    },
    "projects": {
      "columns": { "name": "string" },
      "relations": { "tasks": { "reverse": "tasks", "relation": "project" } }
    },
    "tasks": {
      "columns": { "title": "string", "done": "boolean", "projectId": "uuid" },
      "relations": {
        "comments": { "reverse": "comments", "relation": "task" },
        "project": { "rel": "projects", "column": "projectId" }
      }
    }
  }
}
