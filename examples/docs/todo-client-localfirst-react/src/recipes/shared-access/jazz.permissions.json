{
  "$schema": "https://jazz.tools/schemas/jazz.permissions.v1.json",
  "tables": {
    "todoShares": {
      "read": {
        "anyOf": [
          "user_id = session.user",
          "exists todos(id = this.todoId, $createdBy = session.user)"
        ]
      },
      "insert": "exists todos(id = this.todoId, $createdBy = session.user)",
      "delete": "exists todos(id = this.todoId, $createdBy = session.user)"
    },
    "todos": {
      "read": {
        "anyOf": [
          "$createdBy = session.user",
          "exists todoShares(todoId = this.id, user_id = session.user)"
        ]
      },
      "insert": "true",
      "update": {
        "anyOf": [
          "$createdBy = session.user",
          "exists todoShares(todoId = this.id, user_id = session.user, can_edit = true)"
        ]
      },
      "delete": "$createdBy = session.user"
    }
  }
}
