{
  "$schema": "https://jazz.tools/schemas/jazz.app.schema.json",
  "format": 1,
  "tables": {
    "projects": {
      "columns": { "name": "string" },
      "relations": { "todos": { "reverse": "todos", "relation": "projectRelation" } }
    },
    "todos": {
      "columns": {
        "title": "string",
        "done": "boolean",
        "priority": "int?",
        "description": "string?",
        "parent": "uuid?",
        "project": "uuid?"
      },
      "relations": {
        "children": { "reverse": "todos", "relation": "parentRelation" },
        "parentRelation": { "rel": "todos", "column": "parent" },
        "projectRelation": { "rel": "projects", "column": "project" }
      }
    }
  }
}
