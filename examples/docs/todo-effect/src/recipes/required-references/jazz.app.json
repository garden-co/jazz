{
  "$schema": "https://jazz.tools/schemas/jazz.app.schema.json",
  "format": 1,
  "tables": {
    "customers": {
      "columns": { "name": "string" },
      "relations": { "orders": { "reverse": "orders", "relation": "customer" } }
    },
    "orders": {
      "columns": { "customerId": "uuid" },
      "relations": { "customer": { "rel": "customers", "column": "customerId" } }
    }
  }
}
