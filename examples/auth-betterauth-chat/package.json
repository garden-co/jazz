{
  "name": "auth-betterauth-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "jazz-tools validate && next build",
    "start": "next start",
    "test": "pnpm test:server && pnpm test:browser",
    "test:server": "vitest run --config vitest.config.server.ts",
    "test:browser": "vitest run --config vitest.config.browser.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-auth": "1.7.22",
    "jazz-napi": "workspace:*",
    "jazz-tools": "workspace:*",
    "next": "catalog:default",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "catalog:default",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "catalog:default",
    "@vitest/browser": "catalog:default",
    "@vitest/browser-playwright": "catalog:default",
    "typescript": "catalog:default",
    "vite": "catalog:default",
    "vite-plugin-top-level-await": "catalog:default",
    "vite-plugin-wasm": "catalog:default",
    "vitest": "catalog:default",
    "ws": "^8.19.0"
  }
}
