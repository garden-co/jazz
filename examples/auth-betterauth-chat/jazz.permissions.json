{
  "$schema": "https://jazz.tools/schemas/jazz.permissions.schema.json",
  "format": 1,
  "tables": {
    "better_auth_account": {
      "read": "false",
      "insert": "false",
      "update": "false",
      "delete": "false"
    },
    "better_auth_jwks": { "read": "false", "insert": "false", "update": "false", "delete": "false" },
    "better_auth_session": {
      "read": "false",
      "insert": "false",
      "update": "false",
      "delete": "false"
    },
    "better_auth_user": { "read": "false", "insert": "false", "update": "false", "delete": "false" },
    "better_auth_verification": {
      "read": "false",
      "insert": "false",
      "update": "false",
      "delete": "false"
    },
    "messages": {
      "read": { "anyOf": ["true", "true"] },
      "insert": { "anyOf": [{ "allOf": ["true", "session.claims.role = 'admin'"] }, "true"] },
      "update": {
        "anyOf": [
          { "allOf": ["true", "session.claims.role = 'admin'"] },
          { "allOf": ["true", "$createdBy.account = session.user"] }
        ]
      },
      "delete": {
        "anyOf": [
          { "allOf": ["true", "session.claims.role = 'admin'"] },
          { "allOf": ["true", "$createdBy.account = session.user"] }
        ]
      }
    }
  }
}
