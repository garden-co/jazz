BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_APP_ORIGIN=http://127.0.0.1:3000
# Jazz runs inside the Next app. In development it uses a local app id and
# keeps its data in .jazz/; a deployment names its own app.
# NEXT_PUBLIC_JAZZ_APP_ID=
# To keep the data on a sync server such as Jazz Cloud, set its URL and the
# app's two secrets.
# JAZZ_SERVER_URL=
# JAZZ_ADMIN_SECRET=
# BACKEND_SECRET=
