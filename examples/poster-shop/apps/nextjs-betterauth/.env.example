# The local defaults below need no service: Jazz runs inside the Next app and
# keeps its data in .jazz/. Set your own origin, app id and secret to deploy.
NEXT_PUBLIC_APP_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_JAZZ_APP_ID=00000000-0000-0000-0000-00000000b057
BETTER_AUTH_SECRET=2SNhYRceYvKf1HnJ7mQxB3aWd6LeP9tR4uCg8Vz0Ds5FiOoAbXkMwZq

# To keep the data on a sync server such as Jazz Cloud instead, set its URL
# and the app's two secrets:
# JAZZ_SERVER_URL=https://v2.sync.jazz.tools
# JAZZ_ADMIN_SECRET=...
# BACKEND_SECRET=...
