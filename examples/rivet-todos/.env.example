# Server-only values. Never give these variables a VITE_ prefix.
RIVET_ENDPOINT=http://127.0.0.1:6420
RIVET_NAMESPACE=default
RIVET_TOKEN=
RIVET_POOL=jazz
JAZZ_RIVET_DATABASE=rivet-todos
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JAZZ_CORE_SECRET=

# existing: run `pnpm actor` against an existing Rivet 3.0+ engine/pool.
# managed: createJazz uploads the image and provisions a Rivet Cloud pool.
RIVET_RUNTIME=existing
# JAZZ_RIVET_IMAGE_JSON=/absolute/path/to/crates/jazz-rivet/artifacts/image.json
# RIVET_CLOUD_ENDPOINT=https://your-cloud-api
# RIVET_CLOUD_TOKEN=
# RIVET_ORGANIZATION=
# RIVET_CLUSTER=
# RIVET_REGION=
