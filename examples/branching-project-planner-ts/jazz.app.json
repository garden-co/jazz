{
  "$schema": "https://jazz.tools/schemas/jazz.app.schema.json",
  "format": 1,
  "tables": {
    "scenarios": {
      "columns": {
        "name": "string",
        "base_scenario_id": "uuid?",
        "base_snapshot_ref": "string?",
        "status": { "enum": ["open", "approved", "archived"] }
      },
      "relations": {
        "base_scenario": { "rel": "scenarios", "column": "base_scenario_id" },
        "scenariosViaBase_scenario": { "reverse": "scenarios", "relation": "base_scenario" },
        "tasksViaScenario": { "reverse": "tasks", "relation": "scenario" }
      }
    },
    "tasks": {
      "columns": { "scenario_id": "uuid", "title": "string", "estimate": "int" },
      "relations": { "scenario": { "rel": "scenarios", "column": "scenario_id" } },
      "branchBy": ["scenario_id"]
    }
  }
}
