    "hono": "4.10.6",
    "pg": "8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ws": "8.23.0",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.1",
    "concurrently": "9.2.1",
