  "ui": ["src/BandChat.tsx", "src/components/**/*.tsx", "components/sign-in-form.tsx", "components/theme-provider.tsx", "src/lib/url-state.tsx", "src/lib/use-object-url.ts", "src/globals.css"],
  "exclude": ["seed.ts", "harness.mjs"]
}
