{
  "name": "band-chat-neon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:server\" \"pnpm dev:vite\"",
    "dev:server": "tsx watch --env-file=.env.local server/index.ts",
    "dev:vite": "vite",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx --env-file=.env.local server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astryxdesign/core": "0.6.3",
    "@garden-co/design": "github:garden-co/design#fe96522c2484b894380fab7f0217b76ee4bda3a2",
    "@hono/node-server": "1.19.6",
    "hono": "4.10.6",
    "pg": "8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.1.13",
    "@neon/realtime": "0.2.1",
    "@neon/auth": "0.8.2",
    "jose": "6.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.0.1",
    "concurrently": "9.2.1",
    "tsx": "4.20.6",
    "typescript": "6.0.2",
    "vite": "8.0.1",
    "neon": "9.5.0",
    "@neon/config": "1.14.0"
  }
}
