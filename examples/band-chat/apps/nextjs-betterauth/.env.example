# `pnpm dev` needs no configuration: it runs on http://127.0.0.1:3000 with a
# local Jazz server (from `withJazz`) and secrets it generates into
# .env.development.local (git-ignored).
#
# Deployments (any production build or start) must set all of the following.
# There are no defaults: a missing value stops the app from starting.
NEXT_PUBLIC_APP_ORIGIN=
NEXT_PUBLIC_JAZZ_APP_ID=
NEXT_PUBLIC_JAZZ_SERVER_URL=
# That Jazz server must accept BandChat's JWTs: JWKS at
# <NEXT_PUBLIC_APP_ORIGIN>/api/auth/jwks, issuer = NEXT_PUBLIC_APP_ORIGIN and
# audience = band-chat (JAZZ_JWT_ISSUER / JAZZ_JWT_AUDIENCE). Otherwise every
# sign-in is rejected with 401.
# Optional: the Jazz environment shared by browser and backend (defaults to
# dev, or prod in production builds).
NEXT_PUBLIC_JAZZ_ENV=
# Long random strings, e.g. `openssl rand -base64 32`.
BACKEND_SECRET=
BETTER_AUTH_SECRET=
