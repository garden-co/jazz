{
  "$schema": "https://jazz.tools/schemas/jazz.permissions.v1.json",
  "tables": {
    "better_auth_account": {
      "read": "false",
      "insert": "false",
      "update": "false",
      "delete": "false"
    },
    "better_auth_jwks": { "read": "false", "insert": "false", "update": "false", "delete": "false" },
    "better_auth_session": {
      "read": "false",
      "insert": "false",
      "update": "false",
      "delete": "false"
    },
    "better_auth_user": { "read": "false", "insert": "false", "update": "false", "delete": "false" },
    "better_auth_verification": {
      "read": "false",
      "insert": "false",
      "update": "false",
      "delete": "false"
    },
    "canvases": {
      "read": "exists roomMembers(roomId = this.roomId, memberAuthor = session.user)",
      "insert": "exists roomMembers(roomId = this.roomId, memberAuthor = session.user)",
      "update": "false",
      "delete": "false"
    },
    "joinRequests": {
      "read": {
        "anyOf": [
          "requester = session.user",
          "exists rooms(id = this.roomId, $createdBy.account = session.user)"
        ]
      },
      "insert": {
        "allOf": [
          "requester = session.user",
          "exists profiles(id = this.profileId, author = session.user)"
        ]
      },
      "update": "false",
      "delete": {
        "anyOf": [
          "requester = session.user",
          "exists rooms(id = this.roomId, $createdBy.account = session.user)"
        ]
      }
    },
    "messages": {
      "read": "exists roomMembers(roomId = this.roomId, memberAuthor = session.user)",
      "insert": {
        "allOf": [
          "exists roomMembers(roomId = this.roomId, memberAuthor = session.user)",
          "exists profiles(id = this.senderId, author = session.user)",
          {
            "anyOf": [
              "canvasId = null",
              "exists canvases(id = this.canvasId, roomId = this.roomId)"
            ]
          }
        ]
      },
      "update": "false",
      "delete": "exists profiles(id = this.senderId, author = session.user)"
    },
    "profiles": {
      "read": {
        "anyOf": [
          "author = session.user",
          "allowedTo.read(messagesViaSender)",
          "allowedTo.read(membershipsViaProfile)",
          "allowedTo.read(joinRequestsViaProfile)"
        ]
      },
      "insert": "author = session.user",
      "update": "author = session.user",
      "delete": "author = session.user"
    },
    "reactions": {
      "read": "allowedTo.read(message)",
      "insert": {
        "allOf": [
          "author = session.user",
          "exists messages(id = this.messageId, roomId = this.roomId)",
          "exists roomMembers(roomId = this.roomId, memberAuthor = session.user)"
        ]
      },
      "update": "false",
      "delete": {
        "allOf": [
          "author = session.user",
          "exists messages(id = this.messageId, roomId = this.roomId)",
          "exists roomMembers(roomId = this.roomId, memberAuthor = session.user)"
        ]
      }
    },
    "readMarkers": {
      "read": "exists roomMembers(roomId = this.roomId, memberAuthor = session.user)",
      "insert": {
        "allOf": [
          "reader = session.user",
          "exists roomMembers(roomId = this.roomId, memberAuthor = session.user)"
        ]
      },
      "update": {
        "old": "reader = session.user",
        "new": {
          "allOf": [
            "reader = session.user",
            "exists roomMembers(roomId = this.roomId, memberAuthor = session.user)"
          ]
        }
      },
      "delete": {
        "anyOf": [
          "reader = session.user",
          "exists rooms(id = this.roomId, $createdBy.account = session.user)"
        ]
      }
    },
    "roomMembers": {
      "read": "allowedTo.read(room)",
      "insert": {
        "allOf": [
          "exists rooms(id = this.roomId, $createdBy.account = session.user)",
          "memberProfileId != null",
          "exists profiles(id = this.memberProfileId, author = this.memberAuthor)",
          {
            "anyOf": [
              "memberAuthor = session.user",
              "exists joinRequests(roomId = this.roomId, requester = this.memberAuthor)"
            ]
          }
        ]
      },
      "update": "false",
      "delete": {
        "anyOf": [
          "exists rooms(id = this.roomId, $createdBy.account = session.user)",
          "memberAuthor = session.user"
        ]
      }
    },
    "rooms": {
      "read": {
        "anyOf": [
          "$createdBy.account = session.user",
          "exists roomMembers(roomId = this.id, memberAuthor = session.user)"
        ]
      },
      "insert": "true",
      "update": "$createdBy.account = session.user",
      "delete": "$createdBy.account = session.user"
    },
    "strokes": {
      "read": "exists roomMembers(roomId = this.roomId, memberAuthor = session.user)",
      "insert": {
        "allOf": [
          "author = session.user",
          "exists roomMembers(roomId = this.roomId, memberAuthor = session.user)",
          "exists canvases(id = this.canvasId, roomId = this.roomId)"
        ]
      },
      "update": "false",
      "delete": {
        "allOf": [
          "author = session.user",
          "exists roomMembers(roomId = this.roomId, memberAuthor = session.user)"
        ]
      }
    }
  }
}
