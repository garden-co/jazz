{
  "name": "band-chat-nextjs-betterauth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/ensure-env.js",
    "build": "node ../../../../packages/jazz-tools/dist/cli.js validate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && pnpm typecheck:browser-commands",
    "typecheck:browser-commands": "tsc --project tests/browser/tsconfig.browser-commands.json",
    "test:e2e": "playwright test",
    "test": "pnpm run test:headless && pnpm run test:browser",
    "test:headless": "vitest run --config vitest.config.ts",
    "test:browser": "vitest run --config vitest.config.browser.ts",
    "test:browser:focused": "node scripts/test-browser-focused.mjs"
  },
  "dependencies": {
    "better-auth": "1.6.24",
    "jazz-napi": "workspace:*",
    "jazz-tools": "workspace:*",
    "next": "catalog:default",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "catalog:default",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "catalog:default",
    "@vitest/browser": "catalog:default",
    "@vitest/browser-playwright": "catalog:default",
    "typescript": "catalog:default",
    "vite": "catalog:default",
    "vite-plugin-top-level-await": "catalog:default",
    "vite-plugin-wasm": "catalog:default",
    "vitest": "catalog:default"
  }
}
