# The local defaults below make `pnpm dev` and `pnpm build` work without any
# configuration. Set the public values to a deployed Jazz app to run elsewhere;
# nonlocal deployments must also set both secrets and PAYMENT_PROVIDER.
NEXT_PUBLIC_APP_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_JAZZ_APP_ID=jamazon-local
NEXT_PUBLIC_JAZZ_SERVER_URL=http://127.0.0.1:4200
BACKEND_SECRET=jamazon-development-backend-secret
BETTER_AUTH_SECRET=8fQ2wKx7NcR4bVt1LmZ9aYe3HdS6uJp0GoXi5TrWnEk2BvMs

# Payments. "sandbox" is an in-app provider that never moves money and is
# labelled as such in the UI. "stripe" uses Stripe in test mode (test keys only).
PAYMENT_PROVIDER=sandbox
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
