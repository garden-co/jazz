# `pnpm dev` needs no configuration: it runs on http://127.0.0.1:3000 with a
# local Jazz server, the sandbox payment provider, and secrets it generates
# into .env.development.local (git-ignored).
#
# Deployments (any production build or start) must set all of the following.
# There are no defaults: a missing value stops the app from starting.
NEXT_PUBLIC_APP_ORIGIN=
NEXT_PUBLIC_JAZZ_APP_ID=
NEXT_PUBLIC_JAZZ_SERVER_URL=
# Long random strings, e.g. `openssl rand -base64 32`.
BACKEND_SECRET=
BETTER_AUTH_SECRET=

# Payments. "sandbox" is an in-app provider that never moves money and is
# labelled as such in the UI. "stripe" uses Stripe in test mode (test keys only).
PAYMENT_PROVIDER=
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
