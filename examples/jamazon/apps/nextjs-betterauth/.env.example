# `pnpm dev` needs no configuration: it runs on http://127.0.0.1:3000, keeps
# Jazz data in .jazz/ (git-ignored), uses the sandbox payment provider, and
# generates BETTER_AUTH_SECRET into .env.development.local (git-ignored).
#
# Deployments (any production build or start) must set the following.
# There are no defaults: a missing value stops the app from starting.
NEXT_PUBLIC_APP_ORIGIN=
NEXT_PUBLIC_JAZZ_APP_ID=
# A long random string, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Payments. "sandbox" is an in-app provider that never moves money and is
# labelled as such in the UI. "stripe" uses Stripe in test mode (test keys only).
PAYMENT_PROVIDER=
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Where the data lives. Unset, the backend keeps it in a local SQLite
# directory (JAZZ_DATA_PATH, default .jazz). Set JAZZ_SERVER_URL to sync
# through Jazz Cloud (https://v2.sync.jazz.tools/) or your own sync server,
# with the app's admin and backend secrets. Browsers never see these.
JAZZ_SERVER_URL=
JAZZ_ADMIN_SECRET=
BACKEND_SECRET=
JAZZ_DATA_PATH=
