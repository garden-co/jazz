# Development defaults; production must set each of these.
NEXT_PUBLIC_APP_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_JAZZ_APP_ID=00000000-0000-0000-0000-00000000a6e7
BETTER_AUTH_SECRET=2SNhYRceYvKf1HnJ7mQxB3aWd6LeP9tR4uCg8Vz0Ds5FiOoAbXkMwZq

# Where the data lives. Unset, the app's Jazz keeps it in local SQLite
# (JAZZ_DATA_PATH, default .jazz). Set JAZZ_SERVER_URL to sync through Jazz
# Cloud (https://v2.sync.jazz.tools/) or your own sync server, with the app's
# admin and backend secrets. Browsers never see these.
# JAZZ_SERVER_URL=
# JAZZ_ADMIN_SECRET=
# BACKEND_SECRET=

# Which agent answers. `scripted` (the default) is a deterministic, offline
# agent for demos and tests. `anthropic` streams from the Claude API and needs
# ANTHROPIC_API_KEY.
MUSIC_AGENT_PROVIDER=scripted
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
