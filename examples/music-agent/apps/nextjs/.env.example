# The development defaults below make `pnpm build` deterministic without a
# running service. Set these to the deployed Jazz app and endpoint to run the
# authenticated example against a real backend.
NEXT_PUBLIC_APP_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_JAZZ_APP_ID=music-agent-local
NEXT_PUBLIC_JAZZ_SERVER_URL=http://127.0.0.1:4200
BACKEND_SECRET=music-agent-development-backend-secret
BETTER_AUTH_SECRET=2SNhYRceYvKf1HnJ7mQxB3aWd6LeP9tR4uCg8Vz0Ds5FiOoAbXkMwZq

# Which agent answers. `scripted` (the default) is a deterministic, offline
# agent for demos and tests. `anthropic` streams from the Claude API and needs
# ANTHROPIC_API_KEY.
MUSIC_AGENT_PROVIDER=scripted
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
