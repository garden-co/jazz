{
  "name": "music-agent-nextjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "env NEXT_PUBLIC_APP_ORIGIN=http://127.0.0.1:3000 NEXT_PUBLIC_JAZZ_APP_ID=00000000-0000-0000-0000-00000000a6e7 BETTER_AUTH_SECRET=music-agent-build-better-auth-secret-0123456789 sh -c 'jazz-tools validate && next build'",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@astryxdesign/core": "0.6.3",
    "@garden-co/design": "github:garden-co/design#fe96522c2484b894380fab7f0217b76ee4bda3a2",
    "better-auth": "1.7.1",
    "jazz-napi": "workspace:*",
    "jazz-tools": "workspace:*",
    "next": "catalog:default",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "catalog:default",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "catalog:default",
    "vitest": "catalog:default"
  }
}
