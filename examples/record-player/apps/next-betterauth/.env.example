NEXT_PUBLIC_APP_ORIGIN=http://127.0.0.1:3000
# In development Jazz runs inside the Next app with a local app id and keeps
# its data in .jazz/. Set these for a deployment.
# NEXT_PUBLIC_JAZZ_APP_ID=
# BETTER_AUTH_SECRET=
# To keep the data on a sync server such as Jazz Cloud, also set its URL and
# the app's two secrets.
# JAZZ_SERVER_URL=
# JAZZ_ADMIN_SECRET=
# BACKEND_SECRET=
