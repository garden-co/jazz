NEXT_PUBLIC_APP_ORIGIN=http://127.0.0.1:3000
# In development `withJazz` starts a local Jazz server and supplies the app ID,
# server URL and backend secret. Set all of these for a deployment.
# NEXT_PUBLIC_JAZZ_APP_ID=
# NEXT_PUBLIC_JAZZ_SERVER_URL=
# BACKEND_SECRET=
# BETTER_AUTH_SECRET=
# "dev" or "prod"; defaults to "prod" in production builds and "dev" otherwise.
# NEXT_PUBLIC_JAZZ_ENV=
