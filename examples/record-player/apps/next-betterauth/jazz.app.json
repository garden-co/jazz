    },
    "playlists": {
      "columns": { "name": "string" },
      "relations": {
        "invitationsViaPlaylist": { "reverse": "invitations", "relation": "playlist" },
        "playback_positionsViaPlaylist": { "reverse": "playback_positions", "relation": "playlist" },
        "playlist_entriesViaPlaylist": { "reverse": "playlist_entries", "relation": "playlist" }
      }
    },
    "tracks": {
      "columns": {
        "album_id": "uuid",
        "title": "string",
        "ordinal": "int",
        "duration_ms": "int",
        "audio_bytes": "bytes?",
        "audio_mime": "string?",
        "audio_byte_length": "int?"
      },
