# The development defaults below make `pnpm build` deterministic without a
# running service. Set these to the deployed Jazz app and endpoint to run the
# authenticated example against a real backend.
NEXT_PUBLIC_APP_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_JAZZ_APP_ID=band-book-local
NEXT_PUBLIC_JAZZ_SERVER_URL=http://127.0.0.1:4200
BACKEND_SECRET=band-book-development-backend-secret
BETTER_AUTH_SECRET=band-book-local-development-better-auth-secret
