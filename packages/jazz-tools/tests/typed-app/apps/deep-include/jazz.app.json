{
  "$schema": "https://jazz.tools/schemas/jazz.app.v1.json",
  "tables": {
    "check_notes": {
      "columns": { "body": "string", "user_check_id": "uuid" },
      "relations": { "user_check": { "rel": "user_checks", "column": "user_check_id" } }
    },
    "orgs": {
      "columns": { "name": "string" },
      "relations": { "todosViaOrg": { "reverse": "todos", "relation": "org" } }
    },
    "todos": {
      "columns": { "title": "string", "org_id": "uuid" },
      "relations": {
        "org": { "rel": "orgs", "column": "org_id" },
        "user_checksViaTodo": { "reverse": "user_checks", "relation": "todo" }
      }
    },
    "user_checks": {
      "columns": { "todo_id": "uuid" },
      "relations": {
        "todo": { "rel": "todos", "column": "todo_id" },
        "check_notesViaUser_check": { "reverse": "check_notes", "relation": "user_check" }
      }
    }
  }
}
