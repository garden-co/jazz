{
  "$schema": "https://jazz.tools/schemas/jazz.app.v1.json",
  "tables": {
    "projects": {
      "columns": { "name": "string" },
      "relations": { "todosViaProject": { "reverse": "todos", "relation": "projectRelation" } }
    },
    "todos": {
      "columns": {
        "title": "string",
        "optionalTitle": "string?",
        "done": "boolean",
        "optionalRank": "int?",
        "tags": { "array": "string" },
        "optionalTags": { "array": "string", "optional": true },
        "attachment": "bytes",
        "optionalAttachment": "bytes?",
        "optionalStatus": { "enum": ["new", "done"], "optional": true },
        "project": "uuid",
        "owner": "uuid?"
      },
      "relations": {
        "ownerRelation": { "rel": "users", "column": "owner" },
        "projectRelation": { "rel": "projects", "column": "project" }
      },
      "indexes": ["done"]
    },
    "users": {
      "columns": { "name": "string" },
      "relations": { "todosViaOwner": { "reverse": "todos", "relation": "ownerRelation" } }
    }
  }
}
