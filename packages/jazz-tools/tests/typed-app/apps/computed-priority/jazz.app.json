{
  "$schema": "https://jazz.tools/schemas/jazz.app.v1.json",
  "tables": {
    "items": {
      "columns": { "score": "int", "storedPriority": { "type": "int", "transform": "priority" } },
      "computed": {
        "priority": { "type": { "enum": ["low", "medium", "high"] }, "from": ["id", "score", "storedPriority"] }
      }
    }
  },
  "transforms": { "priority": { "stored": "int", "view": { "enum": ["low", "medium", "high"] } } }
}
