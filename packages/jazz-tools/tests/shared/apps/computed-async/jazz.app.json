{
  "$schema": "https://jazz.tools/schemas/jazz.app.schema.json",
  "format": 1,
  "tables": {
    "rows": {
      "columns": {
        "score": {
          "type": "int",
          "default": 5
        },
        "text": {
          "type": "string",
          "default": "hello"
        }
      },
      "computed": {
        "missing": {
          "type": "int",
          "from": [
            "score"
          ]
        },
        "failing": {
          "type": "int",
          "from": []
        }
      }
    }
  }
}
