{
  "$schema": "https://jazz.tools/schemas/jazz.app.v1.json",
  "tables": {
    "baskets": {
      "columns": {
        "itemId": "uuid"
      },
      "relations": {
        "item": {
          "rel": "items",
          "column": "itemId"
        }
      }
    },
    "items": {
      "columns": {
        "score": {
          "type": "int",
          "default": 5
        },
        "text": {
          "type": "string",
          "default": "hello"
        }
      }
    }
  }
}
