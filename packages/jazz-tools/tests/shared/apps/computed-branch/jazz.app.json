{
  "$schema": "https://jazz.tools/schemas/jazz.app.v1.json",
  "tables": {
    "rows": {
      "columns": {
        "score": "int?",
        "branch": "string"
      },
      "branchBy": [
        "branch"
      ],
      "computed": {
        "value": {
          "type": "int",
          "from": [
            "score"
          ]
        }
      }
    }
  }
}
