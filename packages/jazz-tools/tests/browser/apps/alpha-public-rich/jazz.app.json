{
  "$schema": "https://jazz.tools/schemas/jazz.app.schema.json",
  "format": 1,
  "tables": {
    "todos": {
      "columns": {
        "title": "string",
        "done": "boolean",
        "list": "string",
        "priority": "int",
        "tags": { "array": "string" },
        "payload": "bytes?",
        "ownerId": "uuid?"
      },
      "relations": { "owner": { "rel": "users", "column": "ownerId" } }
    },
    "users": {
      "columns": { "name": "string" },
      "relations": { "todosViaOwner": { "reverse": "todos", "relation": "owner" } }
    }
  }
}
