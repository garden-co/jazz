{
  "$schema": "https://jazz.tools/schemas/jazz.app.schema.json",
  "format": 1,
  "tables": {
    "projects": {
      "columns": { "name": "string" },
      "relations": { "todosViaProject": { "reverse": "todos", "relation": "project" } }
    },
    "todos": {
      "columns": {
        "title": "string",
        "done": "boolean",
        "projectId": "uuid?",
        "tags": { "array": "string", "optional": true }
      },
      "relations": { "project": { "rel": "projects", "column": "projectId" } }
    }
  }
}
