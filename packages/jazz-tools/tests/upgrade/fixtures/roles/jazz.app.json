{
  "$schema": "https://jazz.tools/schemas/jazz.app.schema.json",
  "format": 1,
  "tables": {
    "comments": {
      "columns": { "docId": "uuid", "body": "string" },
      "relations": { "doc": { "rel": "docs", "column": "docId" } }
    },
    "docShares": {
      "columns": { "docId": "uuid", "userId": "string" },
      "relations": { "doc": { "rel": "docs", "column": "docId" } }
    },
    "docs": {
      "columns": {
        "orgId": "uuid",
        "title": "string",
        "status": { "enum": ["draft", "published", "locked"] },
        "authorId": "string"
      },
      "relations": {
        "comments": { "reverse": "comments", "relation": "doc" },
        "org": { "rel": "orgs", "column": "orgId" },
        "shares": { "reverse": "docShares", "relation": "doc" }
      }
    },
    "members": {
      "columns": {
        "orgId": "uuid",
        "userId": "string",
        "role": { "enum": ["admin", "editor", "viewer"] }
      },
      "relations": { "org": { "rel": "orgs", "column": "orgId" } }
    },
    "orgs": {
      "columns": { "name": "string" },
      "relations": {
        "docs": { "reverse": "docs", "relation": "org" },
        "members": { "reverse": "members", "relation": "org" }
      }
    }
  }
}
