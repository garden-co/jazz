{
  "$schema": "https://jazz.tools/schemas/jazz.app.schema.json",
  "format": 1,
  "tables": {
    "tasks": {
      "columns": {
        "title": "string",
        "score": "int",
        "weight": "float",
        "dueAt": "timestamp",
        "tags": "string"
      },
      "tsOnly": {
        "dueAt": "transform",
        "tags": "transform",
        "priority": "computed",
        "label": "computed",
        "done": "computed",
        "doubled": "computed",
        "ratio": "computed",
        "bounded": "computed",
        "createdDay": "computed"
      }
    }
  }
}
