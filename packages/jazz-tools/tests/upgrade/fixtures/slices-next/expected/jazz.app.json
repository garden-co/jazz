{
  "$schema": "https://jazz.tools/schemas/jazz.app.v1.json",
  "tables": {
    "boards": {
      "columns": { "name": "string" },
      "relations": { "cardsViaBoard": { "reverse": "cards", "relation": "board" } }
    },
    "cards": {
      "columns": {
        "boardId": "uuid",
        "title": "string",
        "status": { "enum": ["todo", "doing", "done"] }
      },
      "relations": { "board": { "rel": "boards", "column": "boardId" } }
    }
  }
}
