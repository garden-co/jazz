{
  "$schema": "https://jazz.tools/schemas/jazz.app.schema.json",
  "format": 1,
  "tables": {
    "boards": {
      "columns": { "name": "string" },
      "relations": { "cardsViaBoard": { "reverse": "cards", "relation": "board" } }
    },
    "cards": {
      "columns": {
        "boardId": "uuid",
        "title": "string",
        "status": { "enum": ["todo", "doing", "done"] }
      },
      "relations": { "board": { "rel": "boards", "column": "boardId" } }
    }
  },
  "slices": { "app": ["boards", "cards"], "boardsOnly": ["boards"] }
}
