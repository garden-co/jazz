{
  "$schema": "https://jazz.tools/schemas/jazz.app.v1.json",
  "tables": {
    "better_auth_account": {
      "columns": {
        "accountId": "string",
        "providerId": "string",
        "userId": "uuid",
        "accessToken": "string?",
        "refreshToken": "string?",
        "idToken": "string?",
        "accessTokenExpiresAt": "timestamp?",
        "refreshTokenExpiresAt": "timestamp?",
        "scope": "string?",
        "password": "string?",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      },
      "relations": {
        "user": {
          "rel": "better_auth_user",
          "column": "userId"
        }
      }
    },
    "better_auth_jwks": {
      "columns": {
        "publicKey": "string",
        "privateKey": "string",
        "createdAt": "timestamp",
        "expiresAt": "timestamp?",
        "alg": "string?",
        "crv": "string?"
      }
    },
    "better_auth_session": {
      "columns": {
        "expiresAt": "timestamp",
        "token": "string",
        "createdAt": "timestamp",
        "updatedAt": "timestamp",
        "ipAddress": "string?",
        "userAgent": "string?",
        "userId": "uuid",
        "impersonatedBy": "string?"
      },
      "relations": {
        "user": {
          "rel": "better_auth_user",
          "column": "userId"
        }
      }
    },
    "better_auth_user": {
      "columns": {
        "name": "string",
        "email": "string",
        "emailVerified": "boolean",
        "image": "string?",
        "createdAt": "timestamp",
        "updatedAt": "timestamp",
        "role": "string?",
        "banned": "boolean?",
        "banReason": "string?",
        "banExpires": "timestamp?",
        "login_count": "int?",
        "remaining_uses": "int?",
        "transition_status": "string?"
      },
      "relations": {
        "better_auth_sessionViaUser": {
          "reverse": "better_auth_session",
          "relation": "user"
        },
        "better_auth_accountViaUser": {
          "reverse": "better_auth_account",
          "relation": "user"
        }
      }
    },
    "better_auth_verification": {
      "columns": {
        "identifier": "string",
        "value": "string",
        "expiresAt": "timestamp",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      }
    }
  }
}
