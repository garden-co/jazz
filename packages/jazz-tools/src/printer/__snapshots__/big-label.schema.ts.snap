import { schema as s } from "jazz-tools";

export const schema = s.defineSchema({
  artists: s.table(
    {
      organizationId: s.uuid(),
      name: s.string(),
      genre: s.string(),
      status: s.string(),
      searchKey: s.string(),
    },
    {
      organization: s.rel("organizations", "organizationId"),
      releasesViaArtist: s.reverse("releases", "artist"),
    },
  ),
  better_auth_account: s.table(
    {
      accountId: s.string(),
      providerId: s.string(),
      userId: s.uuid(),
      accessToken: s.string().optional(),
      refreshToken: s.string().optional(),
      idToken: s.string().optional(),
      accessTokenExpiresAt: s.timestamp().optional(),
      refreshTokenExpiresAt: s.timestamp().optional(),
      scope: s.string().optional(),
      password: s.string().optional(),
      createdAt: s.timestamp(),
      updatedAt: s.timestamp(),
    },
    {
      user: s.rel("better_auth_user", "userId"),
    },
  ),
  better_auth_jwks: s.table({
    publicKey: s.string(),
    privateKey: s.string(),
    createdAt: s.timestamp(),
    expiresAt: s.timestamp().optional(),
    alg: s.string().optional(),
    crv: s.string().optional(),
  }),
  better_auth_session: s.table(
    {
      expiresAt: s.timestamp(),
      token: s.string(),
      createdAt: s.timestamp(),
      updatedAt: s.timestamp(),
      ipAddress: s.string().optional(),
      userAgent: s.string().optional(),
      userId: s.uuid(),
    },
    {
      user: s.rel("better_auth_user", "userId"),
    },
  ),
  better_auth_user: s.table(
    {
      name: s.string(),
      email: s.string(),
      emailVerified: s.boolean(),
      image: s.string().optional(),
      createdAt: s.timestamp(),
      updatedAt: s.timestamp(),
    },
    {
      better_auth_accountViaUser: s.reverse("better_auth_account", "user"),
      better_auth_sessionViaUser: s.reverse("better_auth_session", "user"),
    },
  ),
  better_auth_verification: s.table({
    identifier: s.string(),
    value: s.string(),
    expiresAt: s.timestamp(),
    createdAt: s.timestamp(),
    updatedAt: s.timestamp(),
  }),
  catalogues: s.table(
    { organizationId: s.uuid(), name: s.string(), code: s.string() },
    {
      organization: s.rel("organizations", "organizationId"),
      releasesViaCatalogue: s.reverse("releases", "catalogue"),
    },
  ),
  memberships: s.table(
    { organizationId: s.uuid(), personId: s.uuid(), userId: s.uuid(), role: s.string() },
    {
      organization: s.rel("organizations", "organizationId"),
      person: s.rel("people", "personId"),
      releaseAssignmentsViaMembership: s.reverse("releaseAssignments", "membership"),
      teamAssignmentsViaMembership: s.reverse("teamAssignments", "membership"),
    },
  ),
  organizations: s.table(
    { name: s.string(), slug: s.string() },
    {
      artistsViaOrganization: s.reverse("artists", "organization"),
      cataloguesViaOrganization: s.reverse("catalogues", "organization"),
      membershipsViaOrganization: s.reverse("memberships", "organization"),
      releaseAssignmentsViaOrganization: s.reverse("releaseAssignments", "organization"),
      releaseTeamsViaOrganization: s.reverse("releaseTeams", "organization"),
      releasesViaOrganization: s.reverse("releases", "organization"),
      teamAssignmentsViaOrganization: s.reverse("teamAssignments", "organization"),
      teamsViaOrganization: s.reverse("teams", "organization"),
    },
  ),
  people: s.table(
    { userId: s.uuid(), name: s.string() },
    {
      membershipsViaPerson: s.reverse("memberships", "person"),
      personEmailsViaPerson: s.reverse("personEmails", "person"),
    },
  ),
  personEmails: s.table(
    { personId: s.uuid(), email: s.string() },
    {
      person: s.rel("people", "personId"),
    },
  ),
  releaseAssignments: s.table(
    { organizationId: s.uuid(), releaseId: s.uuid(), membershipId: s.uuid(), role: s.string() },
    {
      membership: s.rel("memberships", "membershipId"),
      organization: s.rel("organizations", "organizationId"),
      release: s.rel("releases", "releaseId"),
    },
  ),
  releaseTeams: s.table(
    { organizationId: s.uuid(), releaseId: s.uuid(), teamId: s.uuid() },
    {
      organization: s.rel("organizations", "organizationId"),
      release: s.rel("releases", "releaseId"),
      team: s.rel("teams", "teamId"),
    },
  ),
  releases: s.table(
    {
      organizationId: s.uuid(),
      artistId: s.uuid(),
      catalogueId: s.uuid().optional(),
      catalogNumber: s.string(),
      catalogSequence: s.int().optional(),
      title: s.string(),
      format: s.string(),
      releaseDate: s.timestamp(),
      status: s.string(),
      searchKey: s.string(),
    },
    {
      artist: s.rel("artists", "artistId"),
      catalogue: s.rel("catalogues", "catalogueId"),
      organization: s.rel("organizations", "organizationId"),
      releaseAssignmentsViaRelease: s.reverse("releaseAssignments", "release"),
      releaseTeamsViaRelease: s.reverse("releaseTeams", "release"),
    },
  ),
  teamAssignments: s.table(
    { organizationId: s.uuid(), teamId: s.uuid(), membershipId: s.uuid(), role: s.string() },
    {
      membership: s.rel("memberships", "membershipId"),
      organization: s.rel("organizations", "organizationId"),
      team: s.rel("teams", "teamId"),
    },
  ),
  teams: s.table(
    { organizationId: s.uuid(), name: s.string() },
    {
      organization: s.rel("organizations", "organizationId"),
      releaseTeamsViaTeam: s.reverse("releaseTeams", "team"),
      teamAssignmentsViaTeam: s.reverse("teamAssignments", "team"),
    },
  ),
});

const { definePermissions, exists, allowedTo, session, anyOf, allOf } = schema;

const isMembership = (organizationId: s.Uuid) =>
  exists.memberships({ organizationId, userId: session.user });

const isMembershipAdmin = (organizationId: s.Uuid) =>
  exists.memberships({ organizationId, userId: session.user, role: "admin" });

const isMembershipEditor = (organizationId: s.Uuid) =>
  exists.memberships({ organizationId, userId: session.user, role: "editor" });

const mine = { userId: session.user };

export const permissions = definePermissions({
  artists: {
    read: (artist) => isMembership(artist.organizationId),
    insert: (artist) =>
      anyOf(isMembershipAdmin(artist.organizationId), isMembershipEditor(artist.organizationId)),
    update: (artist) =>
      anyOf(isMembershipAdmin(artist.organizationId), isMembershipEditor(artist.organizationId)),
    delete: (artist) => isMembershipAdmin(artist.organizationId),
  },
  better_auth_account: {
    read: false,
    insert: false,
    update: false,
    delete: false,
  },
  better_auth_jwks: {
    read: false,
    insert: false,
    update: false,
    delete: false,
  },
  better_auth_session: {
    read: false,
    insert: false,
    update: false,
    delete: false,
  },
  better_auth_user: {
    read: false,
    insert: false,
    update: false,
    delete: false,
  },
  better_auth_verification: {
    read: false,
    insert: false,
    update: false,
    delete: false,
  },
  catalogues: {
    read: (catalogue) => isMembership(catalogue.organizationId),
    insert: (catalogue) => isMembershipAdmin(catalogue.organizationId),
    update: (catalogue) => isMembershipAdmin(catalogue.organizationId),
    delete: (catalogue) => isMembershipAdmin(catalogue.organizationId),
  },
  memberships: {
    read: (membership) => isMembership(membership.organizationId),
    insert: (membership) =>
      allOf(
        isMembershipAdmin(membership.organizationId),
        membership.person.where({ userId: membership.userId }),
        anyOf({ role: "editor" }, { role: "viewer" }),
      ),
    updateIf: (membership) => isMembershipAdmin(membership.organizationId),
    updateTo: (membership) =>
      allOf(
        isMembershipAdmin(membership.organizationId),
        membership.person.where({ userId: membership.userId }),
        anyOf({ role: "admin" }, { role: "editor" }, { role: "viewer" }),
      ),
    delete: (membership) => isMembershipAdmin(membership.organizationId),
  },
  organizations: {
    read: (organization) => isMembership(organization.id),
    insert: false,
    update: (organization) => isMembershipAdmin(organization.id),
    delete: (organization) => isMembershipAdmin(organization.id),
  },
  people: {
    read: (person) => anyOf(mine, allowedTo.read(person.membershipsViaPerson)),
    insert: false,
    update: mine,
    delete: false,
  },
  personEmails: {
    read: false,
    insert: false,
    update: false,
    delete: false,
  },
  releaseAssignments: {
    read: (releaseAssignment) => allowedTo.read(releaseAssignment.release),
    insert: (releaseAssignment) =>
      allOf(
        isMembershipAdmin(releaseAssignment.organizationId),
        releaseAssignment.release.where({ organizationId: releaseAssignment.organizationId }),
        releaseAssignment.membership.where({ organizationId: releaseAssignment.organizationId }),
      ),
    updateIf: (releaseAssignment) => isMembershipAdmin(releaseAssignment.organizationId),
    updateTo: (releaseAssignment) =>
      allOf(
        isMembershipAdmin(releaseAssignment.organizationId),
        releaseAssignment.release.where({ organizationId: releaseAssignment.organizationId }),
        releaseAssignment.membership.where({ organizationId: releaseAssignment.organizationId }),
      ),
    delete: (releaseAssignment) => isMembershipAdmin(releaseAssignment.organizationId),
  },
  releaseTeams: {
    read: (releaseTeam) => isMembership(releaseTeam.organizationId),
    insert: (releaseTeam) =>
      allOf(
        anyOf(
          isMembershipAdmin(releaseTeam.organizationId),
          isMembershipEditor(releaseTeam.organizationId),
        ),
        releaseTeam.release.where({ organizationId: releaseTeam.organizationId }),
        releaseTeam.team.where({ organizationId: releaseTeam.organizationId }),
      ),
    update: false,
    delete: (releaseTeam) =>
      anyOf(
        isMembershipAdmin(releaseTeam.organizationId),
        isMembershipEditor(releaseTeam.organizationId),
      ),
  },
  releases: {
    read: (releas) => isMembership(releas.organizationId),
    insert: (releas) =>
      allOf(
        anyOf(isMembershipAdmin(releas.organizationId), isMembershipEditor(releas.organizationId)),
        allOf(
          releas.artist.where({ organizationId: releas.organizationId }),
          anyOf(
            { catalogueId: null },
            releas.catalogue.where({ organizationId: releas.organizationId }),
          ),
        ),
      ),
    updateIf: (releas) =>
      anyOf(isMembershipAdmin(releas.organizationId), isMembershipEditor(releas.organizationId)),
    updateTo: (releas) =>
      allOf(
        anyOf(isMembershipAdmin(releas.organizationId), isMembershipEditor(releas.organizationId)),
        allOf(
          releas.artist.where({ organizationId: releas.organizationId }),
          anyOf(
            { catalogueId: null },
            releas.catalogue.where({ organizationId: releas.organizationId }),
          ),
        ),
      ),
    delete: (releas) => isMembershipAdmin(releas.organizationId),
  },
  teamAssignments: {
    read: (teamAssignment) => allowedTo.read(teamAssignment.team),
    insert: (teamAssignment) =>
      allOf(
        allowedTo.insert(teamAssignment.team),
        teamAssignment.team.where({ organizationId: teamAssignment.organizationId }),
        teamAssignment.membership.where({ organizationId: teamAssignment.organizationId }),
      ),
    updateIf: (teamAssignment) => allowedTo.update(teamAssignment.team),
    updateTo: (teamAssignment) =>
      allOf(
        allowedTo.update(teamAssignment.team),
        teamAssignment.team.where({ organizationId: teamAssignment.organizationId }),
        teamAssignment.membership.where({ organizationId: teamAssignment.organizationId }),
      ),
    delete: (teamAssignment) => allowedTo.delete(teamAssignment.team),
  },
  teams: {
    read: (team) => isMembership(team.organizationId),
    insert: (team) => isMembershipAdmin(team.organizationId),
    update: (team) => isMembershipAdmin(team.organizationId),
    delete: (team) => isMembershipAdmin(team.organizationId),
  },
});
