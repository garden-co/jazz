{
  "name": "create-jazz",
  "version": "2.0.0-alpha.59",
  "description": "Print the Jazz agent brief: setup instructions for your coding agent.",
  "license": "MIT",
  "bin": {
    "create-jazz": "bin/create-jazz.js"
  },
  "files": [
    "bin/**",
    "dist/**",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --out-dir dist",
    "prepublishOnly": "pnpm build",
    "check": "tsc --noEmit",
    "test": "pnpm check && vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:default",
    "tsup": "^8.5.0",
    "typescript": "catalog:default",
    "vitest": "catalog:default",
    "yaml": "^2.7.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
